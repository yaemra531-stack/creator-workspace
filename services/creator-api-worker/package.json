{
  "name": "creator-api-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare D1 Serverless API Gateway for Creator Workspace & Personal Blog",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create creator-hub-db",
    "d1:init:local": "wrangler d1 execute creator-hub-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute creator-hub-db --remote --file=./schema.sql"
  }
}
